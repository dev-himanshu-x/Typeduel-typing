# Runs the standalone Socket.IO server (server/index.ts) on its own host.
# The Next.js app on Vercel is built separately; this image is unrelated to it.
FROM oven/bun:1-slim

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY server ./server
COPY shared ./shared
COPY db ./db
COPY tsconfig.json ./

ENV NODE_ENV=production
EXPOSE 4000

CMD ["bun", "run", "start:server"]
