# Socket.IO server (server/index.ts)
PORT=4000
# Comma-separated list of browser origins allowed to connect
CLIENT_ORIGIN=http://localhost:3000

# Postgres (Neon). Runtime uses the POOLED url (host contains "-pooler"); migrations use the DIRECT one.
# Put real values in .env.local (git-ignored), never here.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

# Next.js client (used once the client is wired up)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
